# GTM-P2M4SXP4 is configured in components/analytics-script.tsx.
# GA4 and Ads destinations stay in the approved GTM container.

# Enable only after the coordinated GTM/Ads review and approval.
NEXT_PUBLIC_GRANULAR_TAG_CONSENT_READY=false
NEXT_PUBLIC_USE_LEAD_EVENT=false

# Server-only emergency switch. VERCEL_ENV must also equal production for SMTP.
# Vercel supplies VERCEL_ENV; never force production in local or preview environments.
CONTACT_DISABLE_DELIVERY=false
